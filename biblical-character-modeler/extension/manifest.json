{
  "manifest_version": 3,
  "name": "Biblical Modeler — Flow Bridge (Teste)",
  "version": "0.4.0",
  "description": "Prova local: envia prompt sob confirmação e detecta somente metadados visuais no projeto Google Flow, sem gerar nem copiar imagens.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://flow.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://renanroveri.com.br/biblical-character-modeler/*",
        "https://www.renanroveri.com.br/biblical-character-modeler/*"
      ],
      "js": [
        "site-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
