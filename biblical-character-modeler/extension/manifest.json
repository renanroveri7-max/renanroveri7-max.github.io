{
  "manifest_version": 3,
  "name": "Biblical Modeler — Flow Bridge (Teste)",
  "version": "0.2.0",
  "description": "Prova de conceito local: verifica a conexão com o Google Flow e identifica controles estruturais sem ler conteúdo nem gerar imagens.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://flow.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://renanroveri.com.br/biblical-character-modeler/*",
        "https://www.renanroveri.com.br/biblical-character-modeler/*"
      ],
      "js": [
        "site-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
